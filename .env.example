POSTGRES_DB=plenora_cockpit
POSTGRES_USER=plenora_cockpit
# Gebruik enkelvoudige quotes voor letterlijke secrets met een $-teken.
POSTGRES_PASSWORD='replace_with_local_password'
# URL-encode gereserveerde tekens in het wachtwoord (bijvoorbeeld $ als %24).
COCKPIT_DATABASE_URL='postgresql+psycopg://plenora_cockpit:replace_with_url_encoded_password@db:5432/plenora_cockpit'
COCKPIT_SECRET_KEY='replace_with_at_least_32_random_characters'
COCKPIT_ENV=development
COCKPIT_ALLOWED_ORIGINS=http://localhost:3100
COCKPIT_COOKIE_SECURE=false
COCKPIT_SESSION_TTL_SECONDS=28800
COCKPIT_LOGIN_RATE_LIMIT=5
COCKPIT_LOGIN_RATE_WINDOW_SECONDS=900
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
COCKPIT_COLLECTOR_SECRET='replace_with_a_separate_32_character_collector_secret'

# Alleen tijdelijk gebruiken bij owner-bootstrap; niet in Git bewaren.
COCKPIT_BOOTSTRAP_EMAIL=
COCKPIT_BOOTSTRAP_PASSWORD=
