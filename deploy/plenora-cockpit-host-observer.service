[Unit]
Description=Generate closed Plenora Cockpit host and backup status

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=plenora-cockpit
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/bash /opt/plenora-observer/app/deploy/host-observer.sh
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/plenora-cockpit
ReadOnlyPaths=/var/backups/plenora/status.json
NoNewPrivileges=true
